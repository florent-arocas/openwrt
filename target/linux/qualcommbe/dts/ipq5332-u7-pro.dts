/dts-v1/;

#include <arm64/qcom/ipq5332.dtsi>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

/ {
	model = "Ubiquiti UniFi U7 Pro";
	compatible = "ubnt,u7-pro", "qcom,ipq5332";

	aliases {
		serial0 = &blsp1_uart0;
		ethernet1 = &xgmac1;
		led-boot = &led_status_white;
		led-failsafe = &led_status_white;
		led-running = &led_status_white;
		led-upgrade = &led_status_white;
	};

	chosen {
		bootargs = "console=ttyMSM0,115200n8";
		bootargs-append = " root=/dev/fit0 rootwait";
		rootdisk = <&kernel0>;
		stdout-path = "serial0:115200n8";
	};

	pwmleds {
		compatible = "pwm-leds";

		led_status_white: led-0 {
			color = <LED_COLOR_ID_WHITE>;
			function = LED_FUNCTION_STATUS;
			pwms = <&pwm 0 1966050 0>;
			max-brightness = <255>;
		};

		led_wlan_blue: led-1 {
			color = <LED_COLOR_ID_BLUE>;
			function = LED_FUNCTION_WLAN;
			pwms = <&pwm 1 1966050 0>;
			max-brightness = <255>;
		};
	};

	keys {
		compatible = "gpio-keys";

		pinctrl-0 = <&button_pins>;
		pinctrl-names = "default";

		reset-button {
			label = "reset";
			linux,code = <KEY_RESTART>;
			gpios = <&tlmm 26 GPIO_ACTIVE_LOW>;
			debounce-interval = <60>;
		};
	};
};

&blsp1_uart0 {
	pinctrl-0 = <&serial_0_pins>;
	pinctrl-names = "default";
	status = "okay";
};

&sleep_clk {
	clock-frequency = <32000>;
};

&xo_board {
	clock-frequency = <24000000>;
};

&qcom_ppe {
	status = "okay";

	ethernet-ports {
		#address-cells = <1>;
		#size-cells = <0>;

		xgmac1: port@1 {
			reg = <1>;
			phy-mode = "2500base-x";
			managed = "in-band-status";
			label = "lan";
			phy-handle = <&phy14>;
			pcs-handle = <&pcs0_ch0>;
			local-mac-address = [00 00 00 00 00 00];
			clocks = <&nsscc NSS_CC_PORT1_MAC_CLK>,
				 <&nsscc NSS_CC_PORT1_RX_CLK>,
				 <&nsscc NSS_CC_PORT1_TX_CLK>;
			clock-names = "mac",
				      "rx",
				      "tx";
			resets = <&nsscc NSS_CC_PORT1_MAC_CLK_ARES>,
				 <&nsscc NSS_CC_PORT1_RX_CLK_ARES>,
				 <&nsscc NSS_CC_PORT1_TX_CLK_ARES>;
			reset-names = "mac",
				      "rx",
				      "tx";
		};
	};
};

&pcs0 {
	status = "okay";
};

&mdio {
	status = "okay";

	pinctrl-names = "default";
	pinctrl-0 = <&mdio1_pins>;

	phy14: ethernet-phy@e {
		compatible = "ethernet-phy-id004d.d101";
		reg = <14>;
		reset-gpios = <&tlmm 25 GPIO_ACTIVE_LOW>;
		reset-assert-us = <10000>;
		reset-deassert-us = <150000>;
	};
};

&pcie0 {
	status = "disabled";
};

&pcie1 {
	status = "okay";
	num-lanes = <1>;

	perst-gpios = <&tlmm 47 GPIO_ACTIVE_LOW>;
	wake-gpios = <&tlmm 48 GPIO_ACTIVE_LOW>;
	pinctrl-names = "default";
	pinctrl-0 = <&pcie1_pins>;

	pcie@0 {
		wifi@0,0 {
			reg = <0x00010000 0 0 0 0>;

			qcom,calibration-variant = "Ubiquiti-U7-Pro-5G-6G";
			qcom,split-phy;
		};
	};
};

&pcie2 {
	status = "disabled";
};

&pcie0_phy {
	status = "disabled";
};

&pcie1_phy {
	reg = <0x004b1000 0x800>;
	num-lanes = <1>;

	qti,multiplexed-phy;
	phy-ahb-shared-reset;

	status = "okay";
};

&pcie2_phy {
	status = "disabled";
};

&pwm {
	pinctrl-names = "default";
	pinctrl-0 = <&pwm_pins>;
	status = "okay";
};

&sdhc {
	#address-cells = <1>;
	#size-cells = <0>;
	bus-width = <4>;
	max-frequency = <192000000>;
	mmc-ddr-1_8v;
	mmc-hs200-1_8v;
	non-removable;
	pinctrl-0 = <&sdc_default_state>;
	pinctrl-names = "default";
	status = "okay";

	card@0 {
		compatible = "mmc-card";
		reg = <0>;

		block {
			compatible = "block-device";

			partitions {
				kernel0: block-partition-kernel0 {
					partname = "kernel0";
				};

				kernel1: block-partition-kernel1 {
					partname = "kernel1";
				};
			};
		};
	};
};

&blsp1_spi0 {
	pinctrl-0 = <&spi_0_data_clk_pins &spi_0_cs_pins>;
	pinctrl-names = "default";
	status = "okay";

	flash@0 {
		compatible = "mxicy,mx25u6435f", "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <50000000>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "0:SBL1";
				reg = <0x00 0x80000>;
				read-only;
			};

			partition@80000 {
				label = "0:MIBIB";
				reg = <0x80000 0x10000>;
				read-only;
			};

			partition@90000 {
				label = "0:BOOTCONFIG";
				reg = <0x90000 0x10000>;
				read-only;
			};

			partition@a0000 {
				label = "0:QSEE";
				reg = <0xa0000 0x170000>;
				read-only;
			};

			partition@210000 {
				label = "0:DEVCFG";
				reg = <0x210000 0x10000>;
				read-only;
			};

			partition@220000 {
				label = "0:TME";
				reg = <0x220000 0x20000>;
				read-only;
			};

			partition@240000 {
				label = "0:CDT";
				reg = <0x240000 0x10000>;
				read-only;
			};

			partition@250000 {
				label = "0:APPSBLENV";
				reg = <0x250000 0x10000>;
			};

			partition@260000 {
				label = "0:APPSBL";
				reg = <0x260000 0xa0000>;
				read-only;
			};

			partition@300000 {
				label = "0:ART";
				reg = <0x300000 0x100000>;
				read-only;
			};

			partition@400000 {
				label = "0:EEPROM";
				reg = <0x400000 0x10000>;
				read-only;
			};
		};
	};
};

&tlmm {
	button_pins: button-state {
		pins = "gpio26";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-up;
	};

	mdio1_pins: mdio1-state {
		mux_0 {
			pins = "gpio27";
			function = "mdc1";
			drive-strength = <8>;
			bias-disable;
		};

		mux_1 {
			pins = "gpio28";
			function = "mdio1";
			drive-strength = <8>;
			bias-pull-up;
		};
	};

	pcie0_pins: pci0-pinmux {
		pins = "gpio38";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-up;
		output-high;
	};

	pcie1_pins: pci1-pinmux {
		pins = "gpio47";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-up;
		output-high;
	};

	pcie2_pins: pci2-pinmux {
		pins = "gpio44";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-up;
		output-high;
	};

	pwm_pins: pwm-pinmux {
		pins = "gpio31", "gpio32";
		function = "pwm1";
		drive-strength = <8>;
	};

	spi_0_data_clk_pins: spi-0-data-clk-state {
		pins = "gpio14", "gpio15", "gpio16";
		function = "blsp0_spi";
		drive-strength = <2>;
		bias-pull-down;
	};

	spi_0_cs_pins: spi-0-cs-state {
		pins = "gpio17";
		function = "blsp0_spi";
		drive-strength = <2>;
		bias-pull-up;
	};

	sdc_default_state: sdc-default-state {
		clk-pins {
			pins = "gpio13";
			function = "sdc_clk";
			drive-strength = <8>;
			bias-disable;
		};

		cmd-pins {
			pins = "gpio12";
			function = "sdc_cmd";
			drive-strength = <8>;
			bias-pull-up;
		};

		data-pins {
			pins = "gpio8", "gpio9", "gpio10", "gpio11";
			function = "sdc_data";
			drive-strength = <8>;
			bias-pull-up;
		};
	};
};
